*{
    font-family: Arial, Helvetica, sans-serif;
    box-sizing: border-box;
    
}
body {
    background-color:white;
}
.Top {
    
    padding: 10px;
    box-shadow: 3px 3px 5px black;
    border-radius:5px;
    margin:10px;
    text-align:center;
    background-color: rgb(219, 146, 10);
}

.navbar a{
    text-decoration: none;
    display:block;
    text-align: center;
    padding:20px;
    color:rgb(219, 146, 10)
    
}
.navbar ul {
    list-style-type:none;
    background: black;
    box-shadow: 3px 3px 5px black;
    margin:0px;
    padding:0px;
    overflow:hidden;
    border-radius:5px;
    border-bottom: 2px solid  rgb(219, 146, 10);
    border-top: 2px solid  rgb(219, 146, 10);
}
.navbar a:hover{
    background-color: rgb(71, 71, 71);
}
.navbar li {
    float:left;
    color:rgb(219, 146, 10);
}

.container{
    float: left;
}

.Rotate {
    background-color: rgb(0, 0, 0);
    width:200px;
    height:200px;
    margin:20px;
    box-shadow: 0 0 35px orange;
}
.Rotate:hover {
    transform: rotate(360deg);
    animation: rotate 1s infinite alternate ease-in-out;
}

@keyframes rotate {
from {
    transform: rotate(0deg);

    
}
to {
    transform:rotate(360deg);
    
}
}
.Skew {
    background-color: rgb(0, 0, 0);
    width:200px;
    height:200px;
    margin:20px;
    box-shadow: 0 0 35px orange;
}
.Skew:hover {
    animation: moveLeft 2s infinite alternate ease-in ;
}
@keyframes moveLeft {
    from {
       transform: skew(0deg);
    }
    to {
       transform: skew(360deg);
    }
}
.scale {
    background-color: rgb(0, 0, 0);
    width:200px;
    height:200px;
    margin:20px;
    box-shadow: 0 0 35px orange;
}
.scale:hover {
    animation: moveCenter 1s infinite alternate ease-in
}
@keyframes moveCenter{
    from {
        transform:scale(1)
    }
    to{
        transform: scale(35);
    }
}

article{
    background-color: gray;
    border-left: 2px solid orange;
    padding:10px;
    border-radius:10px;
    margin:10px;
}
section {
    background-color: coral;
    padding:10px;
    border-radius:10px;
    margin:20px;
}


